# AFTERPACT environment template. Copy to .env (never commit .env).
# No real secrets belong in this file — values below are placeholders.

# API server
PORT=3001
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Snapshot dir for the JSON store (default: ./data). Use :memory: for
# ephemeral runs with no persistence (smoke tests, throwaway probes).
AFTERPACT_DATA_DIR=./data

# PayPal sandbox ONLY for the hackathon. Production stays disabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# Live mode requires BOTH: mode=live AND this explicit opt-in (default off).
PAYPAL_ALLOW_LIVE=false
# Kill switch: when true, new order/capture/refund ops are refused
# (reads, webhooks, and reconciliation stay open).
PAYPAL_KILL_SWITCH=false
# Per-request timeout (ms) for PayPal API calls.
PAYPAL_REQUEST_TIMEOUT_MS=15000
# Tests only: HMAC secret for the mock webhook signer. Never a real credential.
PAYPAL_MOCK_WEBHOOK_SECRET=
# Set to 0 to force-skip the live-sandbox probe even with credentials present.
PAYPAL_LIVE_TEST=1

# Channel3 live product discovery (Engine B). Without a key, discovery
# endpoints report "unconfigured" and searches fail closed (HTTP 503) —
# results are never fabricated. Get a key at https://trychannel3.com
# (no credit card; hackathon promo only if legitimately available).
CHANNEL3_API_KEY=
# Optional Channel3 locale/transport overrides (defaults: US / USD / en).
CHANNEL3_API_BASE=https://api.trychannel3.com
CHANNEL3_COUNTRY=US
CHANNEL3_CURRENCY=USD
CHANNEL3_LANGUAGE=en
# Per-request timeout (ms) for Channel3 API calls.
CHANNEL3_TIMEOUT_MS=15000

# Vultr Serverless Inference (runtime AI, OpenAI-compatible).
# Without a key, every AI surface uses deterministic fallbacks and the
# live probe skips. Key format/value documented in KEY_RETRIEVAL_GUIDE.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1024
AI_SEED=
AI_REASONING_EFFORT=minimal
# Set to 0 to force-skip the live-inference probe even with a key present.
AI_LIVE_TEST=1
# Set to 1 with a VULTR_INFERENCE_API_KEY to run the 30-scenario live eval.
AI_EVAL_LIVE=0

# Operator token for destructive routes (POST /api/demo/reset and
# POST /api/admin/kill-switch). Empty = open (local dev only). ALWAYS set a
# long random value on any shared/public deployment; the UI never needs it.
OPERATOR_TOKEN=
# AG Studio licence key (45-day trial via the form in
# docs/sponsors/AG_STUDIO_UPGRADE_PATH.md). Empty = canvas runs with the
# trial watermark. Served to the browser by design (AG installs keys
# client-side); NEVER commit the key — deploy-time env only.
AG_STUDIO_LICENSE_KEY=
